# Server Port (Render sets PORT automatically)
PORT=3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/voco?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/voco
MONGODB_DB_NAME=voco

# Sentry DSN for performance tracing & profiling
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# CORS Allowed Origin
CORS_ORIGIN=*

# Open-Weight AI Model (Llama-3 / Mistral hosted on Render or local inference)
# Leave OPENWEIGHT_AI_API_URL empty to use local high-fidelity fallback simulation
OPENWEIGHT_AI_API_URL=
OPENWEIGHT_AI_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
OPENWEIGHT_AI_TIMEOUT_MS=6000
OPENWEIGHT_AI_API_KEY=

# ElevenLabs Text-to-Speech API
# Professional & Energetic Voice ID (e.g. 21m00Tcm4TlvDq8ikWAM = Rachel, EXAVITQu4vr4xnSDxMaL = Bella)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2


